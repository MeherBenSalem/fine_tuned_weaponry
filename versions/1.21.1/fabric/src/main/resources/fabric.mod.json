{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/fine-tunned-weaponry",
    "sources": "https://github.com/MeherBenSalem/fine_tuned_weaponry",
    "issues": "https://github.com/MeherBenSalem/fine_tuned_weaponry/issues"
  },
  "license": "${license}",
  "icon": "assets/runeborn/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.nightbeam.runeborn.fabric.RunebornFabric"
    ],
    "client": [
      "io.nightbeam.runeborn.fabric.RunebornFabricClient"
    ]
  },
  "mixins": [
    "runeborn.mixins.json",
    "runeborn.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
